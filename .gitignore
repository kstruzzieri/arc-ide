# Build outputs
/bin/
frontend/dist

# Task's local checksum cache (used by the wails3 Taskfiles to skip up-to-date work)
/.task/

# Wails v3 build assets that `wails3 task common:update:build-assets` emits for
# packaging targets #273 does not maintain (deb/rpm, NSIS, iOS), plus
# the .desktop file generated during every Linux build.
/build/ios/
/build/linux/desktop
/build/linux/firn.desktop
/build/linux/nfpm/
/build/windows/nsis/

# Dependencies
node_modules

# IDE/Editor
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test coverage
coverage.out

# Brainstorming mockups
.superpowers/

# Working plans and specs (WIP, do not commit)
docs/plans/*
docs/superpowers/

# Agent worktrees (created by Task tool with isolation: worktree)
.claude/worktrees/

# Internal working tracker (local-only; lessons.md stays tracked as durable engineering doc)
.claude/tasks/todo.md

# Misc
*.log
*.md5
